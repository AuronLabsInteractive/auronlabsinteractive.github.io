<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>PROSPERITY: 2056 — Account confirmed</title>
<style>
  :root{
    --bg:#050810; --panel:#0c1118; --border:#1a2535;
    --amber:#E6B34A; --teal:#2FD3C4; --text:#E8EDF5; --muted:#7C8698;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html,body{margin:0;padding:0;background:var(--bg);min-height:100%;min-height:100dvh;}
  body{
    display:flex;align-items:center;justify-content:center;
    padding:24px calc(20px + env(safe-area-inset-left,0px)) calc(24px + env(safe-area-inset-bottom,0px));
    font-family:Arial,Helvetica,sans-serif;color:var(--text);
  }
  .card{
    width:100%;max-width:520px;background:var(--panel);
    border:1px solid var(--border);border-radius:16px;overflow:hidden;
  }
  .head{padding:26px 30px;border-bottom:1px solid var(--border);}
  .wordmark{
    font-family:Georgia,'Times New Roman',serif;font-size:22px;font-weight:bold;
    letter-spacing:.14em;color:var(--amber);text-transform:uppercase;
  }
  .brand{
    font-family:'Courier New',monospace;font-size:10px;letter-spacing:.28em;
    color:var(--muted);margin-top:6px;text-transform:uppercase;
  }
  .body{padding:34px 30px 10px;text-align:center;}
  .mark{font-size:46px;line-height:1;margin-bottom:16px;}
  h1{font-size:20px;margin:0 0 12px;font-weight:bold;}
  p{font-size:14px;line-height:1.65;color:#C3CBD8;margin:0 0 10px;}
  .hu{
    margin-top:22px;padding-top:20px;border-top:1px solid var(--border);
    font-size:13px;line-height:1.65;color:#9AA5B5;
  }
  .hu strong{color:#C3CBD8;font-weight:bold;}
  .note{
    margin:22px 30px 0;padding:14px 16px;border-radius:10px;
    background:rgba(230,179,74,.07);border:1px solid rgba(230,179,74,.22);
    font-family:'Courier New',monospace;font-size:11.5px;line-height:1.7;
    color:var(--amber);text-align:center;letter-spacing:.04em;
  }
  .foot{
    margin-top:26px;padding:20px 30px 26px;border-top:1px solid var(--border);
    background:rgba(255,255,255,.015);
    font-family:'Courier New',monospace;font-size:11px;line-height:1.8;color:var(--muted);
  }
  .foot a{color:var(--teal);text-decoration:none;}
  .err .mark{color:#E8637B;}
  .err .note{
    background:rgba(232,99,123,.08);border-color:rgba(232,99,123,.28);color:#E8637B;
  }
</style>
</head>
<body>
<div class="card" id="card">

  <div class="head">
    <div class="wordmark">PROSPERITY: 2056</div>
    <div class="brand">AuronLabs Interactive</div>
  </div>

  <div class="body">
    <div class="mark" id="mark">✓</div>
    <h1 id="title">Account confirmed</h1>
    <p id="text">Your email address has been verified. You can close this page and return to the game — your cloud save is now active.</p>

    <div class="hu">
      <strong id="huTitle">Fiók megerősítve</strong><br>
      <span id="huText">Az e-mail-címed megerősítettük. Bezárhatod ezt az oldalt, és visszatérhetsz a játékba — a felhő-mentés innentől aktív.</span>
    </div>
  </div>

  <div class="note" id="note">Return to the app · Térj vissza az alkalmazásba</div>

  <div class="foot">
    AuronLabs Interactive (EU) · PROSPERITY: 2056<br>
    Privacy / Adatvédelem:
    <a href="mailto:privacy@auronlabsinteractive.com">privacy@auronlabsinteractive.com</a>
  </div>

</div>

<script>
(function(){
  // A Supabase a hash-ben adja vissza az eredményt. Hiba esetén: #error=...&error_description=...
  // Sikeres e-mail-csere esetén a hívó oldal a #email-changed hash-t is használhatja.
  var h = (location.hash || "").replace(/^#/, "");
  var q = {};
  h.split("&").forEach(function(kv){
    if(!kv) return;
    var i = kv.indexOf("="); if(i < 0) return;
    q[decodeURIComponent(kv.slice(0,i))] = decodeURIComponent(kv.slice(i+1).replace(/\+/g," "));
  });

  var el = function(id){ return document.getElementById(id); };

  if (q.error || q.error_code) {
    document.getElementById("card").className = "card err";
    el("mark").textContent = "!";
    el("title").textContent = "Link expired or invalid";
    el("text").textContent = "This confirmation link is no longer valid. Confirmation links expire after a while and can only be used once. Open the game and request a new one.";
    el("huTitle").textContent = "A link lejárt vagy érvénytelen";
    el("huText").textContent = "Ez a megerősítő link már nem érvényes. A linkek egy idő után lejárnak, és csak egyszer használhatók. Nyisd meg a játékot, és kérj újat.";
    el("note").textContent = "Request a new link in the app · Kérj új linket az appban";
    return;
  }

  if (h === "email-changed" || q.type === "email_change") {
    el("title").textContent = "Email address updated";
    el("text").textContent = "Your new email address is now active. You can close this page and return to the game.";
    el("huTitle").textContent = "E-mail-cím frissítve";
    el("huText").textContent = "Az új e-mail-címed mostantól aktív. Bezárhatod ezt az oldalt, és visszatérhetsz a játékba.";
  }
})();
</script>
</body>
</html>
